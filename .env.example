# Server settings for the Legible API. Copy to .env (never commit .env).
# Everything is optional in development; see src/legible/api/settings.py for all fields.

LEGIBLE_ENVIRONMENT=development
# LEGIBLE_DATA_DIR=data                      # SQLite DB, consented uploads, personal adapters
# LEGIBLE_DATABASE_URL=postgresql+psycopg://legible:CHANGE_ME@localhost:5432/legible

# Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# LEGIBLE_JWT_SECRET=

# Phase 1: a checkpoint written by legible-train (best.pt or final.pt)
# LEGIBLE_HTR_CHECKPOINT=runs/htr-large/best.pt
# LEGIBLE_HTR_DEVICE=auto                    # auto | cuda | mps | cpu

# Claude: "what was probably meant", the Talk chatbot, and comprehension questions.
# Without credentials these features fall back to offline behaviour.
# ANTHROPIC_API_KEY=
# LEGIBLE_LLM_MODEL=claude-opus-5-5

# Phase 4 (optional): realistic video avatar via Tavus. Without these the built-in avatar is used.
# LEGIBLE_TAVUS_API_KEY=
# LEGIBLE_TAVUS_REPLICA_ID=
# LEGIBLE_TAVUS_PERSONA_ID=

# Browsers allowed to call the API from another origin (JSON list)
# LEGIBLE_CORS_ORIGINS=["https://legible.example.org"]
