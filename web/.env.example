# Copy to .env.local and adjust. All values are optional.

# Origin of the FastAPI backend when the frontend is served from a different
# origin. Leave empty to use same-origin /api (the dev server proxies /api to
# http://localhost:8000; override the proxy target with LEGIBLE_API_URL).
VITE_API_BASE=

# Where the MediaPipe vision WASM runtime is served from. `npm run dev` and
# `npm run build` copy it from node_modules into public/mediapipe/wasm.
VITE_MEDIAPIPE_WASM_BASE=/mediapipe/wasm

# Face Landmarker model. Self-host it for production.
VITE_FACE_LANDMARKER_MODEL=https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/1/face_landmarker.task
